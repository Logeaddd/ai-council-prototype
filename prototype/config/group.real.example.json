{
  "id": "real-api-council",
  "name": "Real API Council",
  "settings": {
    "maxRounds": 0,
    "minConsensusWeight": 0.75,
    "stopWhenAllSkip": true,
    "agentTimeoutMs": 90000
  },
  "agents": [
    {
      "id": "builder",
      "name": "Builder",
      "role": "Create the strongest practical answer. Keep the answer concise and concrete.",
      "provider": "openai-compatible",
      "apiBaseUrl": "env:AI_COUNCIL_API_BASE_URL",
      "apiKeyEnv": "AI_COUNCIL_API_KEY",
      "model": "env:AI_COUNCIL_MODEL",
      "pricing": { "inputPerMillion": 0.14, "outputPerMillion": 0.28 },
      "costGuardMaxInputTokens": 1000000,
      "costGuardMaxOutputTokens": 384000,
      "weight": 1,
      "enabled": true
    },
    {
      "id": "critic",
      "name": "Critic",
      "role": "Find flaws, false assumptions, missing risks, and counterexamples. Preserve useful dissent.",
      "provider": "openai-compatible",
      "apiBaseUrl": "env:AI_COUNCIL_API_BASE_URL",
      "apiKeyEnv": "AI_COUNCIL_API_KEY",
      "model": "env:AI_COUNCIL_MODEL",
      "pricing": { "inputPerMillion": 0.14, "outputPerMillion": 0.28 },
      "costGuardMaxInputTokens": 1000000,
      "costGuardMaxOutputTokens": 384000,
      "weight": 1,
      "enabled": true,
      "mandatoryRedTeam": true
    },
    {
      "id": "judge",
      "name": "Judge",
      "role": "Synthesize the final decision while preserving unresolved dissent. Do not invent consensus.",
      "provider": "openai-compatible",
      "apiBaseUrl": "env:AI_COUNCIL_API_BASE_URL",
      "apiKeyEnv": "AI_COUNCIL_API_KEY",
      "model": "env:AI_COUNCIL_MODEL",
      "pricing": { "inputPerMillion": 0.14, "outputPerMillion": 0.28 },
      "costGuardMaxInputTokens": 1000000,
      "costGuardMaxOutputTokens": 384000,
      "weight": 1,
      "enabled": true,
      "judge": true
    }
  ]
}
