{
  "id": "default-council",
  "name": "Default AI Council",
  "settings": {
    "maxRounds": 0,
    "minConsensusWeight": 0.75,
    "stopWhenAllSkip": true,
    "agentTimeoutMs": 60000
  },
  "agents": [
    {
      "id": "builder",
      "name": "Builder",
      "role": "Create the strongest practical answer.",
      "team": "Builder Guild",
      "provider": "mock",
      "apiBaseUrl": "mock://local",
      "apiKeyEnv": "BUILDER_API_KEY",
      "model": "mock-builder",
      "weight": 1,
      "enabled": true
    },
    {
      "id": "critic",
      "name": "Critic / Red Team",
      "role": "Find flaws, false assumptions, missing risks, and counterexamples.",
      "team": "Red Team",
      "provider": "mock",
      "apiBaseUrl": "mock://local",
      "apiKeyEnv": "CRITIC_API_KEY",
      "model": "mock-critic",
      "weight": 1,
      "enabled": true,
      "mandatoryRedTeam": true
    },
    {
      "id": "judge",
      "name": "Judge",
      "role": "Synthesize the final decision while preserving unresolved dissent.",
      "team": "Council",
      "provider": "mock",
      "apiBaseUrl": "mock://local",
      "apiKeyEnv": "JUDGE_API_KEY",
      "model": "mock-judge",
      "weight": 1,
      "enabled": true,
      "judge": true
    }
  ]
}
